# Copie para .env e preencha. O .env não vai para o git.

# Endereço público. Sem domínio próprio, use o IP da VPS com sslip.io (ex.: 203.0.113.10 -> 203-0-113-10.sslip.io):
# o Caddy tira o certificado HTTPS sozinho.
DOMINIO=203-0-113-10.sslip.io

POSTGRES_USER=fatec
POSTGRES_DB=fatec
# Gere uma senha forte: openssl rand -base64 24
POSTGRES_PASSWORD=troque-esta-senha

# Opcional: servir as imagens das questões por um CDN gratuito (jsDelivr lendo o repositório público).
# Vazio = o próprio portal serve as imagens.
# FT_IMAGENS_URL=https://cdn.jsdelivr.net/gh/Leo-Porte/fatec-turbo@main/conteudo/q
